#: indico/modules/events/abstracts/__init__.py
#, needs-review
msgid "Gives event managers the opportunity to open a \"Call for Abstracts\" and use the abstract reviewing workflow."
msgstr "Позволяет организаторам мероприятия открыть приём тезисов и использовать рецензирование тезисов."

#: indico/modules/events/abstracts/__init__.py
#, needs-review
msgid "Review for all tracks"
msgstr "Рецензирование во всех секциях"

#: indico/modules/events/abstracts/__init__.py
#, needs-review
msgid "Grants abstract reviewing rights to all tracks of the event."
msgstr "Даёт права на рецензирование тезисов во всех секциях мероприятия."

#: indico/modules/events/abstracts/__init__.py
#, needs-review
msgid "Grants track reviewer rights in a track."
msgstr "Даёт права рецензента в секции."

#: indico/modules/events/abstracts/__init__.py
#, needs-review
msgid "Grants abstract management rights on an event."
msgstr "Даёт права на управление тезисами в мероприятии."

#: indico/modules/events/abstracts/__init__.py
#, needs-review
msgid "Grants abstract reviewing rights on an event."
msgstr "Даёт права на рецензирование тезисов в мероприятии."

#: indico/modules/events/abstracts/clone.py
#, needs-review
msgid "Call for Abstracts (settings, email templates, review questions)"
msgstr "Приём тезисов (настройки, шаблоны писем, вопросы для рецензентов)"

#: indico/modules/events/abstracts/clone.py
#, needs-review
msgid "The target event already has review questions"
msgstr "В целевом мероприятии уже есть вопросы для рецензентов"

#: indico/modules/events/abstracts/clone.py
#, needs-review
msgid "The target event already has email templates"
msgstr "В целевом мероприятии уже есть шаблоны писем"

#: indico/modules/events/abstracts/fields.py
#, needs-review
msgid "You cannot combine the \"Invited\" rule with other rules"
msgstr "Правило «По приглашению» нельзя сочетать с другими правилами"

#: indico/modules/events/abstracts/fields.py
#, needs-review
msgid "Existing notification templates cannot be changed from/to \"Invited\"; please create a new one"
msgstr "Существующий шаблон уведомления нельзя перевести на правило «По приглашению» или обратно — создайте новый шаблон"

#: indico/modules/events/abstracts/fields.py
#: indico/modules/events/contributions/fields.py
#, needs-review, python-brace-format
msgid "{} has no role"
msgstr "{}: роль не указана"

#: indico/modules/events/abstracts/fields.py
#, needs-review
msgid "You must add at least one speaker"
msgstr "Нужно добавить хотя бы одного докладчика (значок микрофона)"

#: indico/modules/events/abstracts/fields.py
#, needs-review
msgid "Enter abstract title or #id"
msgstr "Введите название тезисов или #id"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Whether the content field is available."
msgstr "Доступно ли поле с текстом тезисов."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Whether the user has to fill the content field."
msgstr "Обязательно ли заполнять поле с текстом тезисов."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Their email addresses will be published in the Book of Abstracts."
msgstr "Их адреса электронной почты будут опубликованы в сборнике тезисов."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Multiple tracks"
msgstr "Несколько секций"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow the selection of multiple tracks"
msgstr "Разрешить выбор нескольких секций"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Require tracks"
msgstr "Секция обязательна"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Make the track selection mandatory"
msgstr "Сделать выбор секции обязательным"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Require contrib. type"
msgstr "Тип доклада обязателен"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Make the selection of a contribution type mandatory"
msgstr "Сделать выбор типа доклада обязательным"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow attachments"
msgstr "Разрешить файлы"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow files to be attached to the abstract"
msgstr "Разрешить прикладывать файлы к тезисам"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Copy attachments"
msgstr "Копировать файлы"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Copy attachments to the contribution when accepting an abstract"
msgstr "Копировать файлы в доклад при принятии тезисов"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow the selection of the abstract speakers"
msgstr "Разрешить указывать докладчиков в тезисах"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Require a speaker"
msgstr "Докладчик обязателен"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Make the selection of at least one author as speaker mandatory"
msgstr "Сделать обязательным выбор хотя бы одного автора в качестве докладчика"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Contribution submitters"
msgstr "Кто может подавать материалы доклада"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Specify who will get contribution submission rights once an abstract has been accepted"
msgstr "Укажите, кто получит право подавать материалы доклада после принятия тезисов"

#: indico/modules/events/abstracts/forms.py
#: indico/modules/events/papers/forms.py
#, needs-review
msgid "Authorized submitters"
msgstr "Пользователи с правом подачи"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "These users may always submit abstracts, even outside the regular submission period."
msgstr "Эти пользователи могут подавать тезисы в любое время, даже вне периода подачи."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "These instructions will be displayed right before the submission form"
msgstr "Эти инструкции будут показаны перед формой подачи"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "The event has no contribution types defined."
msgstr "В мероприятии не заданы типы докладов."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow track conveners to judge"
msgstr "Разрешить руководителям секций выносить решения"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Enabling this allows track conveners to make a judgment such as accepting or rejecting an abstract."
msgstr "Руководители секций смогут выносить решения по тезисам, например принимать или отклонять их."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow conveners to change tracks"
msgstr "Разрешить руководителям менять секцию"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Enabling this allows track conveners to update the track an abstract is part of."
msgstr "Руководители секций смогут менять секцию, к которой относятся тезисы."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Force track selection on judgment"
msgstr "Обязательный выбор секции при решении"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Enabling this makes the track selection mandatory when accepting an abstract. This does not affect bulk judgment by managers."
msgstr "Выбор секции станет обязательным при принятии тезисов. Это не влияет на массовое вынесение решений организаторами."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow comments"
msgstr "Разрешить комментарии"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Enabling this allows judges, conveners and reviewers to leave comments on abstracts."
msgstr "Члены комиссии, руководители секций и рецензенты смогут оставлять комментарии к тезисам."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Allow contributors in comments"
msgstr "Комментарии от авторов"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Enabling this allows submitters, authors, and speakers to also participate in the comments."
msgstr "Отправители, авторы и докладчики тоже смогут участвовать в обсуждении."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Comment notifications"
msgstr "Уведомления о комментариях"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Send email notifications when new comments are posted."
msgstr "Отправлять уведомления по электронной почте о новых комментариях."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "These instructions will be displayed right before the reviewing form."
msgstr "Эти инструкции будут показаны перед формой рецензирования."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "Judgment Instructions"
msgstr "Инструкции для членов комиссии"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "These instructions will be displayed right before the decision box."
msgstr "Эти инструкции будут показаны перед полем вынесения решения."

#: indico/modules/events/abstracts/forms.py
#: indico/modules/events/papers/forms.py
#, needs-review
msgid "The scale's 'to' value must be greater than the 'from' value."
msgstr "Значение «до» должно быть больше значения «от»."

#: indico/modules/events/abstracts/forms.py
#: indico/modules/events/papers/forms.py
#, needs-review
msgid "The difference between 'to' and' from' may not be greater than 20."
msgstr "Разница между значениями «до» и «от» не может превышать 20."

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "The abstract will be accepted in this track"
msgstr "Тезисы будут приняты в эту секцию"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "The abstract will be converted into a contribution of this type"
msgstr "Тезисы будут преобразованы в доклад этого типа"

#: indico/modules/events/abstracts/forms.py
#, needs-review
msgid "The generated contribution will be allocated in this session"
msgstr "Созданный доклад будет помещён в эту сессию"

