msgid "Upload custom PDF"
msgstr "Загрузить свой PDF"

#: indico/modules/events/abstracts/client/js/boa.jsx
#, needs-review
msgid "Upload BoA"
msgstr "Загрузить сборник тезисов"

#: indico/modules/events/abstracts/client/js/boa.jsx
#, needs-review
